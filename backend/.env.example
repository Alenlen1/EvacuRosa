PORT=4000

# Comma-separated list of origins allowed to call this API. Defaults to
# local dev only — set this to your real Vercel URL(s) in production
# (e.g. https://evacurosa.vercel.app). See DEPLOYMENT.md.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Supabase — required for real evacuation-center persistence and barangay-admin
# auth. Without these, GET /api/evacuation-centers falls back to a labeled dev
# fixture (read-only); the admin update flow won't work at all until these
# are set and a real Supabase project exists.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only random secret (at least 32 bytes), stable across deployments.
# Used to recover an idempotent assistance submission after a lost response.
ASSISTANCE_TRACKING_SECRET=vdavse24wrsgfxbgchkfgu443
